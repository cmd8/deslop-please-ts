{
  "name": "deslop-please-ts",
  "version": "0.1.1",
  "description": "An opinionated linter to remove sloppy TypeScript code: deep modules, narrow interfaces.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmd8/deslop-please-ts.git"
  },
  "homepage": "https://github.com/cmd8/deslop-please-ts#readme",
  "bugs": {
    "url": "https://github.com/cmd8/deslop-please-ts/issues"
  },
  "type": "module",
  "bin": {
    "deslop-please-ts": "dist/main.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\" \"tests/*.test.ts\"",
    "self": "node src/main.ts",
    "prepare": "npm run build"
  },
  "dependencies": {
    "typescript": "7.1.0-beta",
    "yaml": "^2.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  },
  "keywords": [
    "lint",
    "architecture",
    "typescript"
  ]
}
